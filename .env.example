# Copy to .env.local for development. Never commit real values.

# Resend API key (https://resend.com). Leave empty in development:
# the contact API then logs the lead on the server instead of sending it.
RESEND_API_KEY=

# Inbox that receives contact-form leads.
CONTACT_TO_EMAIL=

# Sender address; must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Megatrend Website <no-reply@example.com>"

# Public site origin, used for canonical URLs, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.megatrend.vn

# Set to "true" to enable the analytics slot (only loads after cookie consent).
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Set to "true" at build time on temporary test deployments to keep them out of search engines.
SITE_NOINDEX=
